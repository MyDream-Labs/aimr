{
  "private": true,
  "name": "aimr-product-ext",
  "version": "1.77.0",
  "description": "AIMR product branding",
  "type": "module",
  "dependencies": {
    "@theia/ai-registry": "1.77.0",
    "@theia/core": "1.77.0",
    "@theia/getting-started": "1.77.0",
    "@theia/vsx-registry": "1.77.0",
    "@theia/workspace": "1.77.0"
  },
  "theiaExtensions": [{
    "frontend": "lib/browser/aimr-frontend-module",
    "electronMain": "lib/electron-main/aimr-main-module"
  }],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MyDream-Labs/aimr.git"
  },
  "bugs": {
    "url": "https://github.com/MyDream-Labs/aimr/issues"
  },
  "files": ["lib", "src", "resources"],
  "scripts": {
    "clean": "rimraf lib *.tsbuildinfo",
    "build": "tsc -b",
    "lint": "eslint --ext js,jsx,ts,tsx src",
    "update:theia": "ts-node ../../scripts/update-theia-version.ts",
    "update:next": "ts-node ../../scripts/update-theia-version.ts next"
  },
  "peerDependencies": { "react": "^19.2.8" },
  "exports": {
    "./package.json": "./package.json",
    "./lib/*.json": "./lib/*.json",
    "./lib/*.js": "./lib/*.js",
    "./lib/*": "./lib/*.js",
    "./*": "./*"
  }
}
