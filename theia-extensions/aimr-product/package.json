    "theia-ide-launcher-ext": "0.1.0-alpha.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@openai/codex-sdk": "0.167.0",
    "@theia/plugin-ext": "1.77.0",
    "@theia/ai-codex": "1.77.0",
    "@theia/ai-mcp-server": "1.77.0",
    "zod": "^4.4.3",
    "@theia/ai-chat": "1.77.0",
    "@theia/ai-chat-ui": "1.77.0",
    "@theia/ai-ide": "1.77.0",
    "@theia/ai-registry": "1.77.0",
    "@theia/core": "1.77.0",
    "@theia/debug": "1.77.0",
    "@theia/getting-started": "1.77.0",
    "@theia/markers": "1.77.0",
    "@theia/memory-inspector": "1.77.0",
    "@theia/monaco": "1.77.0",
    "@theia/monaco-editor-core": "1.108.201",
    "@theia/outline-view": "1.77.0",
    "@theia/test": "1.77.0",
    "@theia/vsx-registry": "1.77.0",
    "@theia/workspace": "1.77.0"
  },
  "theiaExtensions": [{
    "frontend": "lib/browser/aimr-frontend-module",
    "backend": "lib/node/aimr-backend-module",
    "electronMain": "lib/electron-main/aimr-main-module"
  }, {
    "frontendElectron": "lib/electron-browser/aimr-electron-frontend-module"
  }],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MyDream-Labs/aimr.git"
  },
  "bugs": {
