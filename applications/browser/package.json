{
  "private": true,
  "name": "theia-ide-browser-app",
  "description": "A living AI-powered workspace that adapts to your goals",
  "productName": "AIMR",
  "version": "0.1.0-alpha.5",
  "license": "MIT",
  "author": "MyDream Labs LLC",
  "homepage": "https://aimr.site",
  "bugs": {
    "url": "https://github.com/MyDream-Labs/aimr/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MyDream-Labs/aimr.git"
  },
  "engines": {
    "yarn": ">=1.7.0 <2",
    "node": ">=24"
  },
  "theia": {
    "frontend": {
      "config": {
        "applicationName": "AIMR",
        "defaultTheme": { "light": "aimr-light", "dark": "aimr-dark" },
        "warnOnPotentiallyInsecureHostPattern": false,
        "preferences": {
          "voxpilot.model": "whisper-base",
          "voxpilot.language": "en",
          "voxpilot.outputAction": "chat",
          "voxpilot.autoSubmitRules": { "chat": false, "cursor": false, "clipboard": false },
          "ai-features.AiEnable.enableAI": true,
          "workbench.startupEditor": "none",
          "toolbar.showToolbar": false,
          "workbench.statusBar.visible": false,
          "window.menuBarVisibility": "toggle",
          "files.enableTrash": false,
          "security.workspace.trust.enabled": false
        },
        "reloadOnReconnect": true
      }
    },
    "backend": {
      "config": {
        "warnOnPotentiallyInsecureHostPattern": false,
        "startupTimeout": -1,
        "resolveSystemPlugins": false,
        "configurationFolder": ".aimr",
        "frontendConnectionTimeout": 3000
      }
    },
    "generator": {
      "config": {
        "preloadTemplate": "../../theia-extensions/aimr-product/resources/preload.html"
      }
    }
  },
  "dependencies": {
    "@theia/ai-anthropic": "1.77.0",
    "@theia/ai-chat": "1.77.0",
    "@theia/ai-chat-ui": "1.77.0",
    "@theia/ai-chatgpt": "1.77.0",
    "@theia/ai-claude-code": "1.77.0",
    "@theia/ai-code-completion": "1.77.0",
    "@theia/ai-codex": "1.77.0",
    "@theia/ai-copilot": "1.77.0",
    "@theia/ai-core": "1.77.0",
    "@theia/ai-core-ui": "1.77.0",
    "@theia/ai-editor": "1.77.0",
    "@theia/ai-google": "1.77.0",
    "@theia/ai-history": "1.77.0",
    "@theia/ai-huggingface": "1.77.0",
    "@theia/ai-ide": "1.77.0",
    "@theia/ai-llamafile": "1.77.0",
    "@theia/ai-mcp": "1.77.0",
    "@theia/ai-mcp-server": "1.77.0",
    "@theia/ai-mcp-ui": "1.77.0",
    "@theia/ai-ollama": "1.77.0",
    "@theia/ai-openai": "1.77.0",
    "@theia/ai-registry": "1.77.0",
    "@theia/ai-scanoss": "1.77.0",
    "@theia/ai-terminal": "1.77.0",
    "@theia/bulk-edit": "1.77.0",
    "@theia/callhierarchy": "1.77.0",
    "@theia/collaboration": "1.77.0",
    "@theia/console": "1.77.0",
    "@theia/core": "1.77.0",
    "@theia/debug": "1.77.0",
    "@theia/dev-container": "1.77.0",
    "@theia/editor": "1.77.0",
    "@theia/editor-preview": "1.77.0",
    "@theia/external-terminal": "1.77.0",
    "@theia/file-search": "1.77.0",
    "@theia/filesystem": "1.77.0",
    "@theia/getting-started": "1.77.0",
    "@theia/keymaps": "1.77.0",
    "@theia/markers": "1.77.0",
    "@theia/memory-inspector": "1.77.0",
    "@theia/messages": "1.77.0",
    "@theia/metrics": "1.77.0",
    "@theia/mini-browser": "1.77.0",
    "@theia/monaco": "1.77.0",
    "@theia/navigator": "1.77.0",
    "@theia/notebook": "1.77.0",
    "@theia/outline-view": "1.77.0",
    "@theia/output": "1.77.0",
    "@theia/plugin-dev": "1.77.0",
    "@theia/plugin-ext": "1.77.0",
    "@theia/plugin-ext-vscode": "1.77.0",
    "@theia/preferences": "1.77.0",
    "@theia/process": "1.77.0",
    "@theia/property-view": "1.77.0",
    "@theia/remote": "1.77.0",
    "@theia/scanoss": "1.77.0",
    "@theia/scm": "1.77.0",
    "@theia/search-in-workspace": "1.77.0",
